{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "CartoonEpisodePlan",
  "description": "Schema for automated 2D/2.5D cartoon video factory episode generation",
  "type": "object",
  "required": [
    "topic",
    "title",
    "character_name",
    "target_duration_seconds",
    "scenes"
  ],
  "properties": {
    "topic": {
      "type": "string",
      "description": "The educational or explanatory topic"
    },
    "title": {
      "type": "string",
      "description": "Engaging, high-CTR YouTube Short / video title"
    },
    "character_name": {
      "type": "string",
      "default": "Archie"
    },
    "target_duration_seconds": {
      "type": "number",
      "minimum": 5,
      "maximum": 300
    },
    "category": {
      "type": "string",
      "enum": ["science", "technology", "money_business", "history", "everyday_explanations", "what_if"],
      "default": "everyday_explanations"
    },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "scene",
          "duration",
          "dialogue",
          "character_action",
          "emotion",
          "camera",
          "objects"
        ],
        "properties": {
          "scene": {
            "type": "integer",
            "minimum": 1
          },
          "duration": {
            "type": "number",
            "minimum": 1.0,
            "maximum": 60.0
          },
          "dialogue": {
            "type": "string",
            "minLength": 1
          },
          "character_action": {
            "type": "string",
            "enum": [
              "idle",
              "talking",
              "walking",
              "point_right",
              "point_left",
              "thinking",
              "laughing",
              "surprise",
              "excitement",
              "looking_left",
              "looking_right"
            ]
          },
          "emotion": {
            "type": "string",
            "enum": [
              "neutral",
              "happy",
              "surprised",
              "curious",
              "excited",
              "thinking",
              "concerned",
              "laughing"
            ]
          },
          "camera": {
            "type": "string",
            "enum": [
              "wide",
              "medium",
              "close_up",
              "medium_to_close",
              "pan_left",
              "pan_right"
            ]
          },
          "objects": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "background_style": {
            "type": "string"
          },
          "effects": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "sfx_cue": {
            "type": "string"
          }
        }
      }
    }
  }
}
